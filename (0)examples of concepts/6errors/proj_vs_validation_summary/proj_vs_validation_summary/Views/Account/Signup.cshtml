@* Tells the view which model class it receives from the controller.
   This enables strongly-typed helpers like asp-for. *@
@model ValidationDemo.Models.SignupModel

@* A Razor code block: sets the page title, which the layout uses in <title>. *@
@{
    ViewData["Title"] = "Sign up";
}

<h1>Sign up</h1>

@* Show a success message if the controller stored one in TempData.
   "is string msg" checks that it exists and is a string, then assigns it to msg. *@
@if (TempData["Success"] is string msg)
{
    <div class="alert alert-success">@msg</div>
}

@* asp-action="Signup" makes the form post to the Signup action
   of the current controller (the [HttpPost] version). *@
<form asp-action="Signup" method="post" style="max-width: 360px;">

    @* Validation summary, Displays only model-level errors *@
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        @* Generates a <label> using the property name (or [Display] attribute). *@
        <label asp-for="Username" class="form-label"></label>

        @* Generates an <input> with the right id, name, and value,
           plus validation attributes taken from the model's data annotations. *@
        <input asp-for="Username" class="form-control" />

        @* Displays the validation error for the Username field only. *@
        <span asp-validation-for="Username" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>

        @* Because Password has [DataType(DataType.Password)] in the model,
           this renders as type="password" so the text is masked. *@
        <input asp-for="Password" class="form-control" />

        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Create account</button>
</form>

@* Injects scripts into the layout's @RenderSection("Scripts") spot. *@
@section Scripts {
    @* Loads jQuery Validation so field errors appear instantly in the browser,
       before the form is sent to the server. *@
    <partial name="_ValidationScriptsPartial" />
}